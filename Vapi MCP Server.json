    {
      "parameters": {
        "jsCode": "const rows = (n) => $(n).all().map(i => i.json).filter(r => r && Object.keys(r).length > 1);\nconst customers = rows('Read Customers').filter(r => r.Email);\nconst bookings = rows('Read Bookings').filter(r => r['Booking ID']);\nconst transcripts = rows('Read Transcripts').filter(r => r['Conversation ID']);\nconst summaries = rows('Read AI Summaries').filter(r => r['Conversation ID']);\nconst tmap = Object.fromEntries(transcripts.map(t => [t['Conversation ID'], t]));\nconst smap = Object.fromEntries(summaries.map(s => [s['Conversation ID'], s]));\nconst convs = rows('Read Conversations').filter(r => r['Conversation ID']).map(c => ({ ...c, Transcript: (tmap[c['Conversation ID']] || {}).Transcript || '', Summary: (smap[c['Conversation ID']] || {}).Summary || '', _tRow: (tmap[c['Conversation ID']] || {}).row_number || null, _sRow: (smap[c['Conversation ID']] || {}).row_number || null }));\nconst services = rows('Read Services').filter(r => r.Service);\nconst packages = rows('Read Packages').filter(r => r.Package);\nconst activity = rows('Read Admin Activity').filter(r => r.Timestamp).slice(-200).reverse();\nreturn [{ json: { success: true, generatedAt: new Date().toISOString(), customers, bookings, conversations: convs, transcripts, summaries, services, packages, activity, hours: 'Mon-Sat 08:00-18:00 Eastern, Sunday closed' } }];"
