        "jsCode": "const SECRET = 'hx_7Kq2vP9mWn4Rt8Ys3Lb6Df1Gh5Jz';\nconst ADMIN_USERS = ['admin321@example.com', 'admin321@exampl.com', 'admin321'], ADMIN_PASS = 'Admin321';\nconst r = $input.first().json;\nconst h = r.headers || {};\nlet b = r.body || {};\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nconst args = (b.args && typeof b.args === 'object') ? b.args : (b.parameters && typeof b.parameters === 'object' ? b.parameters : b);\nlet tool = String(b.tool || b.name || args.tool || (r.query || {}).tool || '').trim().toLowerCase();\nlet authorized = (h['x-hercules-key'] || (r.query || {}).key) === SECRET;\nlet admin = false;\nif (tool.startsWith('admin_')) {\n  admin = ADMIN_USERS.includes(String(b.adminUser || '').trim().toLowerCase()) && String(b.adminPass || '').trim() === ADMIN_PASS;\n  authorized = admin;\n  const map = { admin_login: 'admin_snapshot', admin_snapshot: 'admin_snapshot', admin_cancel: 'cancel_appointment', admin_reschedule: 'reschedule_appointment', admin_availability: 'check_availability', admin_create_booking: 'book_appointment', admin_save_customer: 'register_customer', admin_delete_customer: 'admin_delete_customer', admin_row_create: 'admin_row', admin_row_update: 'admin_row', admin_row_delete: 'admin_row' };\n  if (['admin_row_create','admin_row_update','admin_row_delete'].includes(tool)) args.op = tool.replace('admin_row_', '');\n  tool = map[tool] || 'unknown';\n  if (args && typeof args === 'object') { delete args.adminPass; delete args.adminUser; if (tool !== 'admin_row') args.source = 'admin'; }\n}\nreturn [{ json: { authorized, admin, tool, args, receivedAt: new Date().toISOString() } }];"
