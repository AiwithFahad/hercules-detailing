    {
      "parameters": {
        "jsCode": "const ALLOWED = ['Customers','Bookings','Services','Packages','Conversations','Transcripts','AI Summaries','Cancellations','Rescheduling History'];\nconst a = $input.first().json.args || {};\nconst op = String(a.op || '');\nconst sheet = String(a.sheet || '');\nif (!ALLOWED.includes(sheet)) return [{ json: { op: 'invalid', message: 'Sheet not allowed: ' + sheet } }];\nconst row = {};\nfor (const [k, v] of Object.entries(a.row || {})) { if (k !== 'row_number' && typeof v !== 'object') row[k] = v === null || v === undefined ? '' : String(v); }\nconst rn = parseInt(a.row_number, 10);\nif ((op === 'update' || op === 'delete') && !(rn >= 2)) return [{ json: { op: 'invalid', message: 'A valid row_number is required.' } }];\nif ((op === 'create' || op === 'update') && !Object.keys(row).length) return [{ json: { op: 'invalid', message: 'No fields to save.' } }];\nif (op === 'update') row.row_number = rn;\nreturn [{ json: { op, sheet, row_number: rn || null, row, summary: `${op} ${sheet}${rn ? ' row ' + rn : ''}`, details: JSON.stringify(row).slice(0, 400) } }];"
      },
      "id": "a895c170-fff3-451b-b29f-6a56ac22b0dc",
      "name": "Prepare Row Operation",
