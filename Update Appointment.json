      "parameters": {
        "jsCode": "const p = $('Plan Reschedule').first().json;\nconst clash = $input.all().map(e => e.json).filter(e => e && e.id && e.id !== p.eventId && e.status !== 'cancelled' && e.transparency !== 'transparent');\nreturn [{ json: { ...p, free: clash.length === 0 } }];"
      },
