    {
      "parameters": {
        "jsCode": "const TZ = 'America/New_York';\nconst i = $('When Executed by Another Workflow').first().json;\nconst fail = (m) => [{ json: { ok: false, message: m } }];\nconst id = String(i.bookingId || '').trim().toUpperCase();\nconst ev = String(i.eventID || '').trim();\nconst rows = $input.all().map(r => r.json).filter(r => r['Booking ID']);\nconst b = rows.find(r => (id && String(r['Booking ID']).toUpperCase() === id) || (ev && r['Event ID'] === ev));\nif (!b) return fail('No booking found with that booking ID. Look up the appointment first.');\nif (b.Status === 'Cancelled') return fail('That booking was cancelled and cannot be rescheduled. Make a new booking instead.');\nconst start = DateTime.fromISO(String(i.newStartTime || ''), { setZone: true }).setZone(TZ);\nif (!start.isValid) return fail('New start time must be a full ISO date-time.');\nconst dur = parseInt(b['Duration (min)'], 10) || 60;\nconst end = start.plus({ minutes: dur });\nif (start.weekday === 7) return fail('We are closed on Sundays.');\nif (start < start.set({ hour: 8, minute: 0 }) || end > start.set({ hour: 18, minute: 0, second: 0 })) return fail(`This ${dur}-minute appointment must fit between 8:00 AM and 6:00 PM.`);\nif (start < DateTime.now().setZone(TZ)) return fail('That time is in the past.');\nreturn [{ json: { ok: true, bookingId: b['Booking ID'], eventId: b['Event ID'], email: b.Email, service: b.Service, oldStart: b.Start, newStart: start.toISO(), newEnd: end.toISO(), durationMinutes: dur, label: start.toFormat(\"cccc d LLLL 'at' h:mm a\") } }];"
      },
