    {
      "parameters": {
        "jsCode": "const TZ = 'America/New_York';\nconst i = $input.first().json;\nconst DUR = { 'exterior hand wash': 60, 'maintenance': 60, 'interior deep clean': 120, 'leather & fabric care': 90, 'leather and fabric care': 90, 'wheels & engine bay': 90, 'wheels and engine bay': 90, 'full detail': 240, 'paint correction': 360, 'ceramic coating': 480, 'ceramic pro': 480 };\nconst NAMES = { 'exterior hand wash': 'Exterior Hand Wash', 'maintenance': 'Maintenance Package', 'interior deep clean': 'Interior Deep Clean', 'leather & fabric care': 'Leather & Fabric Care', 'leather and fabric care': 'Leather & Fabric Care', 'wheels & engine bay': 'Wheels & Engine Bay', 'wheels and engine bay': 'Wheels & Engine Bay', 'full detail': 'Full Detail Package', 'paint correction': 'Paint Correction', 'ceramic coating': 'Ceramic Coating', 'ceramic pro': 'Ceramic Pro Package' };\nconst fail = (m) => [{ json: { valid: false, message: m } }];\nconst email = String(i.email || '').trim().toLowerCase();\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) return fail('A valid customer email is required before booking.');\nconst svc = String(i.service || '').trim().toLowerCase();\nconst key = Object.keys(DUR).find(k => svc.includes(k));\nif (!key) return fail('Unknown service. Choose one of: Exterior Hand Wash, Interior Deep Clean, Paint Correction, Ceramic Coating, Leather & Fabric Care, Wheels & Engine Bay, or the Maintenance, Full Detail or Ceramic Pro package.');\nconst start = DateTime.fromISO(String(i.startTime || ''), { setZone: true }).setZone(TZ);\nif (!start.isValid) return fail('Start time must be a full ISO date-time, e.g. 2026-11-06T09:00:00-05:00.');\nconst big = /suv|truck|van|pickup|classic|4x4|minivan/.test(String(i.vehicleType || i.vehicle || '').toLowerCase());\nconst base = DUR[key];\nconst duration = Math.min(Math.ceil((big && base < 480 ? base * 1.25 : base) / 30) * 30, 600);\nconst end = start.plus({ minutes: duration });\nif (start.weekday === 7) return fail('We are closed on Sundays. Please choose Monday to Saturday.');\nconst open = start.set({ hour: 8, minute: 0, second: 0, millisecond: 0 });\nconst close = start.set({ hour: 18, minute: 0, second: 0, millisecond: 0 });\nif (start < open || end > close) return fail(`A ${duration}-minute ${NAMES[key]} must start at 8:00 AM or later and finish by 6:00 PM. Latest start that day: ${close.minus({ minutes: duration }).toFormat('h:mm a')}.`);\nif (start < DateTime.now().setZone(TZ)) return fail('That time is in the past. Please choose a future time.');\nconst bookingId = 'HD-' + start.toFormat('yyMMdd') + '-' + Math.random().toString(36).slice(2, 6).toUpperCase();\nreturn [{ json: { valid: true, bookingId, email, fullName: String(i.fullName || '').trim(), phone: String(i.phoneNumber || '').replace(/[^\\d+]/g, ''), service: NAMES[key], vehicle: String(i.vehicle || ''), vehicleType: String(i.vehicleType || ''), notes: String(i.notes || ''), source: String(i.source || 'voice'), durationMinutes: duration, startTime: start.toISO(), endTime: end.toISO(), label: start.toFormat(\"cccc d LLLL 'at' h:mm a\") } }];"
      },
