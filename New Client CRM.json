    {
      "parameters": {
        "jsCode": "const i = $('When Executed by Another Workflow').first().json;\nconst existing = $('Find Existing Customer').first().json || {};\nconst email = String(i.email || '').trim().toLowerCase();\nconst name = String(i.fullName || '').trim();\nconst phone = String(i.phoneNumber || '').replace(/[^\\d+]/g, '');\nconst errors = [];\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) errors.push('a valid email address');\nif (!name) errors.push('full name');\nif (phone.replace(/\\D/g, '').length < 7) errors.push('a valid phone number');\nif (errors.length) return [{ json: { valid: false, success: false, message: 'Cannot register customer. Missing: ' + errors.join(', ') + '.' } }];\nconst isUpdate = !!existing.Email;\nconst keep = (k, v) => (v !== undefined && v !== null && String(v).trim() !== '') ? String(v).trim() : (existing[k] || '');\nreturn [{ json: {\n  valid: true,\n  isUpdate,\n  row: {\n    'Customer ID': existing['Customer ID'] || ('CUS-' + Date.now().toString(36).toUpperCase()),\n    Name: name,\n    Email: email,\n    Phone: \"'\" + phone,\n    'Vehicle Make': keep('Vehicle Make', i.vehicleMake),\n    'Vehicle Model': keep('Vehicle Model', i.vehicleModel),\n    'Vehicle Year': keep('Vehicle Year', i.vehicleYear),\n    'Vehicle Type': keep('Vehicle Type', i.vehicleType),\n    Registration: keep('Registration', i.registration),\n    'Created At': existing['Created At'] || new Date().toISOString(),\n    Source: existing.Source || i.source || 'voice'\n  }\n} }];"
      },
