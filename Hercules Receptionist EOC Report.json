    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body || raw;\nconst d = body.data || body;\nconst a = d.analysis || {};\nconst dc = a.data_collection_results || {};\nconst v = (k) => (dc[k] && dc[k].value !== undefined && dc[k].value !== null) ? String(dc[k].value) : '';\nconst md = d.metadata || {};\nconst start = md.start_time_unix_secs ? new Date(md.start_time_unix_secs * 1000) : new Date();\nconst dur = Number(md.call_duration_secs || 0);\nconst end = new Date(start.getTime() + dur * 1000);\nconst lines = (d.transcript || []).filter(t => t && t.message).map(t => `[${Math.floor((t.time_in_call_secs || 0) / 60)}:${String((t.time_in_call_secs || 0) % 60).padStart(2, '0')}] ${t.role === 'agent' ? 'Receptionist' : 'Customer'}: ${t.message}`);\nconst transcript = lines.join('\\n').slice(0, 49000);\nconst dyn = (d.conversation_initiation_client_data || {}).dynamic_variables || {};\nconst channel = dyn.channel || (md.phone_call ? 'phone' : (lines.length && !dur ? 'text' : 'web'));\nconst outcome = v('call_outcome') || (a.call_successful === 'success' ? 'Resolved' : a.call_successful === 'failure' ? 'Unresolved' : 'Unknown');\nreturn [{ json: {\n  conversationId: d.conversation_id || ('conv-' + Date.now()),\n  startedAt: start.toISOString(),\n  endedAt: end.toISOString(),\n  durationSecs: dur,\n  customerName: v('customer_name'),\n  customerEmail: v('customer_email').toLowerCase(),\n  customerPhone: v('customer_phone'),\n  intent: v('intent') || 'General enquiry',\n  bookingId: v('booking_id'),\n  outcome,\n  bookingStatus: v('booking_status') || 'None',\n  channel,\n  summary: a.transcript_summary || 'No summary generated.',\n  transcript: transcript || '(empty transcript)',\n  loggedAt: new Date().toISOString()\n} }];"
      },
