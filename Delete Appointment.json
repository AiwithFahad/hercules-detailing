    {
      "parameters": {
        "jsCode": "const i = $('When Executed by Another Workflow').first().json;\nconst id = String(i.bookingId || '').trim().toUpperCase();\nconst ev = String(i.eventID || '').trim();\nconst b = $input.all().map(r => r.json).find(r => r['Booking ID'] && ((id && String(r['Booking ID']).toUpperCase() === id) || (ev && r['Event ID'] === ev)));\nif (!b) return [{ json: { ok: false, message: 'No booking found with that booking ID. Look up the appointment first.' } }];\nif (b.Status === 'Cancelled') return [{ json: { ok: false, message: `Booking ${b['Booking ID']} is already cancelled.` } }];\nreturn [{ json: { ok: true, bookingId: b['Booking ID'], eventId: b['Event ID'], email: b.Email, service: b.Service, start: b.Start, reason: String(i.reason || 'Customer request') } }];"
      },
